<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+.
   Exclude the large AI model directory from both cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>